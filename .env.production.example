# Peanut OS production deployment template.
# Copy this file to .env.production on the server and replace every secret.

# Caddy
PEANUT_DOMAIN=app.example.com
ACME_EMAIL=admin@example.com

NEXT_PUBLIC_WEB_URL=https://app.example.com
NEXT_PUBLIC_API_URL=/api/v1
CORS_ORIGIN=https://app.example.com

# Reverse proxy mode:
# - Caddy mode uses PEANUT_DOMAIN and ACME_EMAIL from this file.
# - NGINX Proxy Manager mode uses the external Docker network below.
NPM_NETWORK=npm_proxy

PEANUT_IMAGE_REGISTRY=ghcr.io
PEANUT_IMAGE_NAMESPACE=OWNER_OR_ORG/REPOSITORY
PEANUT_IMAGE_TAG=latest

NEXT_PUBLIC_BRAND_NAME=Peanut OS
NEXT_PUBLIC_COMPANY_NAME=Peanut OS Corp
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

POSTGRES_USER=peanut_user
POSTGRES_PASSWORD=replace-with-a-url-safe-password
POSTGRES_DB=peanut_db

REDIS_PASSWORD=replace-with-a-strong-redis-password

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace-with-at-least-32-random-characters
REFRESH_TOKEN_EXPIRES_IN=7d

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=replace-with-base64-32-byte-key
APPLICATION_ENCRYPTION_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f

S3_REGION=us-east-1
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=replace-with-a-strong-minio-password
S3_BUCKET=peanut-os-documents
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=true

WEBHOOK_SIGNING_SECRET=replace-with-webhook-signing-secret
WEBHOOK_ENCRYPTION_KEY=replace-with-32-plus-random-characters
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_CONCURRENCY=5
WEBHOOK_SCHEDULER_TIMEZONE=America/Sao_Paulo
WEBHOOK_INVOICE_DUE_SOON_HOURS=72
WEBHOOK_CONTRACT_ENDING_SOON_DAYS=15
WEBHOOK_TICKET_FEEDBACK_HOURS_AFTER_RESOLVED=24

BILLING_SCHEDULE_CRON=0 2 * * *
PDF_MAX_CONCURRENCY=1
API_BODY_LIMIT_BYTES=26214400
LOG_LEVEL=info
