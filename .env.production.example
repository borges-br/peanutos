# Peanut OS production deployment template.
# Copy this file to .env.production on the server and replace every secret.

# Caddy
PEANUT_DOMAIN=app.example.com
ACME_EMAIL=admin@example.com

NEXT_PUBLIC_WEB_URL=https://app.example.com
NEXT_PUBLIC_API_URL=/api/v1
CORS_ORIGIN=https://app.example.com

# Reverse proxy mode:
# - Caddy mode uses PEANUT_DOMAIN and ACME_EMAIL from this file.
# - NGINX Proxy Manager mode uses the external Docker network below.
NPM_NETWORK=npm_proxy

# Images are published under the full GitHub repository path.
# For this repository, use: ghcr.io/borges-br/peanutos/peanut-web:latest
PEANUT_IMAGE_REGISTRY=ghcr.io
PEANUT_IMAGE_NAMESPACE=borges-br/peanutos
PEANUT_IMAGE_TAG=latest


POSTGRES_USER=peanut_user
POSTGRES_PASSWORD=replace-with-a-url-safe-password
POSTGRES_DB=peanut_db

REDIS_PASSWORD=replace-with-a-strong-redis-password

JWT_SECRET=replace-with-at-least-32-random-characters

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Preserve APPLICATION_ENCRYPTION_KEY if an existing installation still uses that legacy alias.
APP_ENCRYPTION_KEY=replace-with-base64-32-byte-key


WEBHOOK_ENCRYPTION_KEY=replace-with-32-plus-random-characters
WEBHOOK_MAX_CONCURRENCY=5

PDF_MAX_CONCURRENCY=1
API_BODY_LIMIT_BYTES=26214400

# Private files. Docker mounts a shared persistent volume at /data/storage.
# Local development: leave blank to use <repository>/data/storage.
# To override locally, use the SAME absolute path for API and worker.
STORAGE_PATH=/data/storage
# Time zone is managed in Settings > General and stored in the database.


# Configurações pela interface: marca, fuso, SMTP, sessão, alertas e limites de webhooks.
# SMTP: Configurações > Integrações. Sessão e automações: Configurações > Operação.
# Preserve APP_ENCRYPTION_KEY e WEBHOOK_ENCRYPTION_KEY com o backup do banco.
