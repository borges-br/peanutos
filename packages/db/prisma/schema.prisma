// ==============================================================================
// PEANUT OS - PRISMA SCHEMA DEFINITION
// ==============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------------------------

enum UserRole {
  OWNER
  ADMIN
  TECHNICIAN
  FINANCIAL
  READ_ONLY
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  PROSPECT
}

enum AssetType {
  WORKSTATION
  NOTEBOOK
  SERVER
  PRINTER
  ROUTER
  SWITCH
  ACCESS_POINT
  FIREWALL
  CAMERA
  NVR
  UPS
  RACK
  NAS
  MOBILE_DEVICE
  VIRTUAL_MACHINE
  CLOUD_SERVICE
  LICENSE
  SOFTWARE_LICENSE
  VPN
  STORAGE
  OTHER
}

enum AssetStatus {
  OPERATIONAL
  MAINTENANCE
  IN_MAINTENANCE
  OUT_OF_STANDARD
  STOCK
  IN_STOCK
  RETIRED
  SCRAPPED
  LOST
  PENDING_VALIDATION
  PENDING_REVIEW
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
  CRITICAL
}

enum TicketStatus {
  OPEN
  TRIAGE
  IN_PROGRESS
  WAITING_CLIENT
  WAITING_THIRD_PARTY
  RESOLVED
  CLOSED
  CANCELLED
}

enum TicketChannel {
  WHATSAPP
  EMAIL
  PHONE
  PORTAL
  MANUAL
  OTHER
}

enum DocumentType {
  QUOTE
  INVOICE
  TICKET_CLOSURE
  CONTRACT
  REPORT
  SERVICE_ORDER
}

enum ContractStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  EXPIRED
  CANCELLED
  TERMINATED
}

enum ContractType {
  RECURRING_SUPPORT
  PROJECT
  ON_DEMAND
  HYBRID
}

enum RenewalMode {
  NONE
  MONTHLY
  ANNUAL
  MANUAL
}

enum ContractLineItemType {
  SERVICE
  LICENSE
  STORAGE
  SUPPORT
  MONITORING
  BACKUP
  OTHER
}

enum BillingScheduleStatus {
  PENDING
  DRAFT_READY
  SKIPPED
  CANCELLED
  GENERATED_FUTURE_INVOICE
}


// ------------------------------------------------------------------------------
// MODELS
// ------------------------------------------------------------------------------

model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  slug      String   @unique @db.VarChar(100)
  status    String   @default("ACTIVE") @db.VarChar(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // White-label Brand Settings
  brandName                  String? @db.VarChar(150)
  brandSubtitle              String? @db.VarChar(150)
  legalName                  String? @db.VarChar(200)
  companyDocument            String? @db.VarChar(30)
  companyEmail               String? @db.VarChar(150)
  financialEmail             String? @db.VarChar(150)
  companyPhone               String? @db.VarChar(30)
  companyWebsite             String? @db.VarChar(255)
  companyAddress             String? @db.Text
  primaryColorHex            String? @db.VarChar(7)
  documentSecondaryColor     String? @db.VarChar(7)
  documentAccentColor        String? @db.VarChar(7)
  documentFooterText         String? @db.Text
  defaultInvoiceNotes        String? @db.Text
  defaultQuoteTerms          String? @db.Text
  defaultServiceOrderTerms   String? @db.Text
  defaultContractTerms       String? @db.Text
  signatureName              String? @db.VarChar(150)
  logoFileObjectId           String? @db.Uuid
  invoiceDueSoonOffsetHours  Int     @default(72)

  // Relationships
  users                    User[]
  clients                  Client[]
  clientUsers         ClientUser[]
  assets              Asset[]
  assetHistories      AssetHistory[]
  assetNotes          AssetNote[]
  tickets             Ticket[]
  ticketCategories    TicketCategory[]
  quotes              Quote[]
  serviceOrders       ServiceOrder[]
  invoices            Invoice[]
  contracts           Contract[]
  contractLineItems   ContractLineItem[]
  contractHistories   ContractHistory[]
  billingScheduleEvents BillingScheduleEvent[]
  fileObjects         FileObject[]
  generatedDocuments  GeneratedDocument[]
  outboxEvents        OutboxEvent[]
  webhookEndpoints         WebhookEndpoint[]
  webhookDeliveries        WebhookDelivery[]
  webhookEventLogs         WebhookEventLog[]
  inboundWebhookEndpoints  InboundWebhookEndpoint[]
  auditLogs                AuditLog[]
  ticketComments           TicketComment[]
  ticketHistories          TicketHistory[]
  ticketTimeEntries        TicketTimeEntry[]
  slaPolicies              SlaPolicy[]
  documentTemplateSettings DocumentTemplateSetting[]

  @@map("workspaces")
}

model User {
  id                        String     @id @default(uuid()) @db.Uuid
  workspaceId               String     @db.Uuid
  name                      String     @db.VarChar(150)
  email                     String     @unique @db.VarChar(150)
  passwordHash              String     @db.VarChar(255)
  role                      UserRole   @default(READ_ONLY)
  status                    UserStatus @default(ACTIVE)
  lastLoginAt               DateTime?
  createdAt                 DateTime   @default(now())
  updatedAt                 DateTime   @updatedAt
  deletedAt                 DateTime?

  // Profile & Document Identity
  jobTitle                  String?    @db.VarChar(150)
  phone                     String?    @db.VarChar(30)
  documentDisplayName       String?    @db.VarChar(150)
  documentSignatureEnabled  Boolean    @default(false)
  avatarFileObjectId        String?    @db.Uuid
  signatureImageFileObjectId String?   @db.Uuid

  // Relationships
  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignedTickets Ticket[]       @relation("AssignedTo")
  ticketComments TicketComment[]
  auditLogs      AuditLog[]
  assetNotes     AssetNote[]
  assetHistories AssetHistory[]
  ticketHistories TicketHistory[]
  ticketTimeEntries TicketTimeEntry[]
  contractHistories ContractHistory[]
  serviceOrders ServiceOrder[] @relation("ServiceOrderResponsible")

  @@index([workspaceId])
  @@map("users")
}

model Client {
  id          String       @id @default(uuid()) @db.Uuid
  workspaceId String       @db.Uuid
  slaPolicyId String?      @db.Uuid
  type        String       @default("LEGAL_PERSON") @db.VarChar(30) // LEGAL_PERSON or NATURAL_PERSON
  legalName   String       @db.VarChar(200)
  tradeName   String?      @db.VarChar(200)
  document    String?      @db.VarChar(20) // CPF or CNPJ, normalized digits
  email       String?      @db.VarChar(150)
  phone       String?      @db.VarChar(30)
  website     String?      @db.VarChar(255)
  notes       String?      @db.Text
  status      ClientStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relationships
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  slaPolicy      SlaPolicy?      @relation(fields: [slaPolicyId], references: [id], onDelete: SetNull)
  contacts       ClientContact[]
  clientUsers    ClientUser[]
  assets         Asset[]
  assetHistories AssetHistory[]
  assetNotes     AssetNote[]
  tickets        Ticket[]
  quotes         Quote[]
  serviceOrders         ServiceOrder[]
  invoices              Invoice[]
  contracts             Contract[]
  billingScheduleEvents BillingScheduleEvent[]

  @@unique([workspaceId, document])
  @@index([workspaceId])
  @@map("clients")
}

model ClientContact {
  id           String   @id @default(uuid()) @db.Uuid
  clientId     String   @db.Uuid
  name         String   @db.VarChar(150)
  email        String   @db.VarChar(150)
  phone        String?  @db.VarChar(30)
  mobile       String?  @db.VarChar(30)
  role         String?  @db.VarChar(100)
  department   String?  @db.VarChar(100)
  isPrimary    Boolean  @default(false)
  notes        String?  @db.Text
  status       String   @default("ACTIVE") @db.VarChar(20)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relationships
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tickets      Ticket[]

  @@index([clientId])
  @@map("client_contacts")
}

model ClientUser {
  id                 String   @id @default(uuid()) @db.Uuid
  workspaceId        String   @db.Uuid
  clientId           String   @db.Uuid
  fullName           String   @db.VarChar(150)
  email              String   @db.VarChar(150)
  phone              String?  @db.VarChar(30)
  department         String?  @db.VarChar(100)
  jobTitle           String?  @db.VarChar(100)
  status             String   @default("ACTIVE") @db.VarChar(20)
  primaryAssetId     String?  @db.Uuid
  folderPermissions  String?  @db.Text
  printerAccess      String?  @db.Text
  accessHours        String?  @db.VarChar(100)
  storageQuota       BigInt?
  notes              String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relationships
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client             Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assets             Asset[]   @relation("AssetUser")
  tickets            Ticket[]

  @@index([clientId])
  @@index([workspaceId])
  @@map("client_users")
}

model Asset {
  id                     String      @id @default(uuid()) @db.Uuid
  workspaceId            String      @db.Uuid
  clientId               String      @db.Uuid
  assignedClientUserId   String?     @db.Uuid
  name                   String      @db.VarChar(150)
  hostname               String?     @db.VarChar(100)
  type                   AssetType   @default(WORKSTATION)
  status                 AssetStatus @default(OPERATIONAL)
  manufacturer           String?     @db.VarChar(100)
  model                  String?     @db.VarChar(100)
  serialNumber           String?     @db.VarChar(100)
  assetTag               String?     @db.VarChar(50)
  macAddress             String?     @db.VarChar(50)
  operatingSystem        String?     @db.VarChar(100)
  location               String?     @db.VarChar(100)
  remoteAccessId         String?     @db.VarChar(100)
  sensitiveDataEncrypted String?     @db.Text
  notes                  String?     @db.Text
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  // Relationships
  workspace          Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client             Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assignedClientUser ClientUser?    @relation("AssetUser", fields: [assignedClientUserId], references: [id], onDelete: SetNull)
  tickets            Ticket[]
  history            AssetHistory[]
  assetNotes         AssetNote[]

  @@index([workspaceId, clientId, type])
  @@index([clientId, status])
  @@map("assets")
}

model Ticket {
  id                    String         @id @default(uuid()) @db.Uuid
  workspaceId           String         @db.Uuid
  clientId              String         @db.Uuid
  contactId             String?        @db.Uuid
  clientUserId          String?        @db.Uuid
  assetId               String?        @db.Uuid
  contractId            String?        @db.Uuid
  slaPolicyId           String?        @db.Uuid
  categoryId            String?        @db.Uuid
  number                String         @unique @db.VarChar(50)
  title                 String         @db.VarChar(200)
  description           String         @db.Text
  category              String?        @db.VarChar(100)
  subcategory           String?        @db.VarChar(100)
  channel               TicketChannel  @default(EMAIL)
  priority              TicketPriority @default(MEDIUM)
  status                TicketStatus   @default(OPEN)
  assignedToId          String?        @db.Uuid
  openedAt              DateTime       @default(now())
  firstResponseAt       DateTime?
  startedAt             DateTime?
  resolvedAt            DateTime?
  closedAt              DateTime?
  slaDueFirstResponseAt DateTime?
  slaDueStartAt         DateTime?
  slaDueResolutionAt    DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  // Relationships
  workspace     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client        Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contact       ClientContact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  clientUser    ClientUser?     @relation(fields: [clientUserId], references: [id], onDelete: SetNull)
  asset         Asset?          @relation(fields: [assetId], references: [id], onDelete: SetNull)
  contract      Contract?       @relation(fields: [contractId], references: [id], onDelete: SetNull)
  slaPolicy     SlaPolicy?      @relation(fields: [slaPolicyId], references: [id], onDelete: SetNull)
  categoryRef   TicketCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  assignedTo    User?           @relation("AssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  comments      TicketComment[]
  closure       TicketClosure?
  invoices      Invoice[]
  serviceOrders ServiceOrder[]
  history       TicketHistory[]
  timeEntries   TicketTimeEntry[]

  @@index([workspaceId, status, priority])
  @@index([workspaceId, categoryId])
  @@map("tickets")
}

model TicketCategory {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  name        String   @db.VarChar(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tickets     Ticket[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("ticket_categories")
}

model TicketComment {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  ticketId    String   @db.Uuid
  userId      String?  @db.Uuid
  content     String   @db.Text
  isInternal  Boolean  @default(false)
  visibility  String   @default("INTERNAL") @db.VarChar(50) // INTERNAL or CLIENT_VISIBLE_FUTURE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ticket      Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([workspaceId])
  @@map("ticket_comments")
}

model TicketClosure {
  id                 String    @id @default(uuid()) @db.Uuid
  ticketId           String    @unique @db.Uuid
  closureSummary     String    @db.Text
  rootCause          String?   @db.Text
  preventiveAction   String?   @db.Text
  technicalHoursUsed Decimal   @default(0) @db.Decimal(5, 2)
  clientApproved     Boolean   @default(false)
  clientSignatureName String?   @db.VarChar(150)
  closedAt           DateTime  @default(now())

  // Relationships
  ticket             Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("ticket_closures")
}

model Quote {
  id                 String      @id @default(uuid()) @db.Uuid
  workspaceId        String      @db.Uuid
  clientId           String?     @db.Uuid
  clientName         String?     @db.VarChar(200)
  clientDocument     String?     @db.VarChar(20)
  clientEmail        String?     @db.VarChar(150)
  clientPhone        String?     @db.VarChar(30)
  number             String      @unique @db.VarChar(50)
  status             String      @default("DRAFT") @db.VarChar(20) // DRAFT, SENT, ACCEPTED, REJECTED, CANCELLED
  issueDate          DateTime    @default(now())
  validUntil         DateTime
  subtotalServices   Decimal     @db.Decimal(12, 2)
  subtotalMaterials  Decimal     @db.Decimal(12, 2)
  subtotalMaterialCost Decimal   @default(0) @db.Decimal(12, 2)
  discountAmount     Decimal     @default(0) @db.Decimal(12, 2)
  terms              String?     @db.Text
  observations       String?     @db.Text
  totalAmount        Decimal     @db.Decimal(12, 2)
  netAmount          Decimal     @default(0) @db.Decimal(12, 2)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  // Relationships
  workspace          Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client             Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  items              QuoteItem[]
  invoices           Invoice[]

  @@index([workspaceId, status, validUntil])
  @@map("quotes")
}

model QuoteItem {
  id          String   @id @default(uuid()) @db.Uuid
  quoteId     String   @db.Uuid
  type        String   @db.VarChar(30) // SERVICE or MATERIAL
  description String   @db.Text
  quantity    Decimal  @db.Decimal(10, 2)
  unit        String   @db.VarChar(20)
  unitPrice   Decimal  @db.Decimal(12, 2)
  unitCost    Decimal  @default(0) @db.Decimal(12, 2)
  totalPrice  Decimal  @db.Decimal(12, 2)
  totalCost   Decimal  @default(0) @db.Decimal(12, 2)
  sortOrder   Int      @default(0)

  // Relationships
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("quote_items")
}

model ServiceOrder {
  id                 String      @id @default(uuid()) @db.Uuid
  workspaceId        String      @db.Uuid
  clientId           String?     @db.Uuid
  clientName         String?     @db.VarChar(200)
  clientDocument     String?     @db.VarChar(20)
  clientEmail        String?     @db.VarChar(150)
  clientPhone        String?     @db.VarChar(30)
  ticketId           String?     @db.Uuid
  contractId         String?     @db.Uuid
  responsibleUserId  String?     @db.Uuid
  number             String      @unique @db.VarChar(50)
  status             String      @default("DRAFT") @db.VarChar(20) // DRAFT, SCHEDULED, IN_PROGRESS, COMPLETED, CANCELLED
  title              String      @db.VarChar(200)
  description        String      @db.Text
  scheduledFor       DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  laborMinutes       Int         @default(0)
  internalNotes      String?     @db.Text
  clientNotes        String?     @db.Text
  subtotalServices   Decimal     @default(0) @db.Decimal(12, 2)
  subtotalMaterials  Decimal     @default(0) @db.Decimal(12, 2)
  subtotalMaterialCost Decimal   @default(0) @db.Decimal(12, 2)
  totalAmount        Decimal     @default(0) @db.Decimal(12, 2)
  netAmount          Decimal     @default(0) @db.Decimal(12, 2)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  // Relationships
  workspace          Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client             Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  ticket             Ticket?     @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  contract           Contract?   @relation(fields: [contractId], references: [id], onDelete: SetNull)
  responsibleUser    User?       @relation("ServiceOrderResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  items              ServiceOrderItem[]

  @@index([workspaceId, status, scheduledFor])
  @@index([workspaceId, clientId])
  @@index([ticketId])
  @@map("service_orders")
}

model ServiceOrderItem {
  id             String       @id @default(uuid()) @db.Uuid
  serviceOrderId String       @db.Uuid
  type           String       @db.VarChar(30) // SERVICE or MATERIAL
  description    String       @db.Text
  quantity       Decimal      @db.Decimal(10, 2)
  unit           String       @db.VarChar(20)
  unitPrice      Decimal      @default(0) @db.Decimal(12, 2)
  unitCost       Decimal      @default(0) @db.Decimal(12, 2)
  totalPrice     Decimal      @default(0) @db.Decimal(12, 2)
  totalCost      Decimal      @default(0) @db.Decimal(12, 2)
  sortOrder      Int          @default(0)

  // Relationships
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  @@index([serviceOrderId])
  @@map("service_order_items")
}

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  workspaceId   String        @db.Uuid
  clientId      String?       @db.Uuid
  clientName    String?       @db.VarChar(200)
  clientDocument String?      @db.VarChar(20)
  clientEmail   String?       @db.VarChar(150)
  clientPhone   String?       @db.VarChar(30)
  quoteId       String?       @db.Uuid
  contractId    String?       @db.Uuid
  ticketId      String?       @db.Uuid
  number        String        @unique @db.VarChar(50)
  status        String        @default("DRAFT") @db.VarChar(20) // DRAFT, ISSUED, PAID, OVERDUE, CANCELLED
  issueDate     DateTime      @default(now())
  dueDate       DateTime
  paymentMethod String        @default("PIX") @db.VarChar(30)
  pixKey        String?       @db.VarChar(100)
  subtotalServices   Decimal   @default(0) @db.Decimal(12, 2)
  subtotalMaterials  Decimal   @default(0) @db.Decimal(12, 2)
  subtotalMaterialCost Decimal @default(0) @db.Decimal(12, 2)
  discountAmount     Decimal   @default(0) @db.Decimal(12, 2)
  discountReason     String?   @db.Text
  observations       String?   @db.Text
  totalAmount   Decimal       @db.Decimal(12, 2)
  netAmount     Decimal       @default(0) @db.Decimal(12, 2)
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relationships
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client        Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  quote         Quote?        @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  contract      Contract?     @relation(fields: [contractId], references: [id], onDelete: SetNull)
  ticket        Ticket?       @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  items         InvoiceItem[]

  @@index([workspaceId, status, dueDate])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @db.Uuid
  type        String   @db.VarChar(30) // SERVICE or MATERIAL
  description String   @db.Text
  quantity    Decimal  @db.Decimal(10, 2)
  unit        String   @db.VarChar(20)
  unitPrice   Decimal  @db.Decimal(12, 2)
  unitCost    Decimal  @default(0) @db.Decimal(12, 2)
  totalPrice  Decimal  @db.Decimal(12, 2)
  totalCost   Decimal  @default(0) @db.Decimal(12, 2)
  sortOrder   Int      @default(0)

  // Relationships
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model Contract {
  id                     String    @id @default(uuid()) @db.Uuid
  workspaceId            String    @db.Uuid
  clientId               String    @db.Uuid
  number                 String    @unique @db.VarChar(50)
  title                  String    @db.VarChar(150)
  description            String?   @db.Text
  status                 ContractStatus @default(DRAFT)
  type                   ContractType   @default(RECURRING_SUPPORT)
  startDate              DateTime
  endDate                DateTime?
  renewalMode            RenewalMode    @default(MONTHLY)
  billingDay             Int            @default(5)
  monthlyAmountCents     Int            @default(0)
  currency               String         @default("BRL") @db.VarChar(3)
  slaPolicyId            String?        @db.Uuid
  maxUsers               Int?
  maxAssets              Int?
  includedRemoteTickets  Int?
  includedOnsiteVisits   Int?
  includedRemoteHours    Int?
  includedOnsiteHours    Int?
  notes                  String?        @db.Text
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  // Relationships
  workspace              Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client                 Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  slaPolicy              SlaPolicy? @relation(fields: [slaPolicyId], references: [id], onDelete: SetNull)
  tickets                Ticket[]
  serviceOrders          ServiceOrder[]
  invoices               Invoice[]
  lineItems              ContractLineItem[]
  history                ContractHistory[]
  billingScheduleEvents  BillingScheduleEvent[]

  @@index([workspaceId])
  @@map("contracts")
}

model ContractLineItem {
  id              String               @id @default(uuid()) @db.Uuid
  workspaceId     String               @db.Uuid
  contractId      String               @db.Uuid
  description     String               @db.VarChar(255)
  itemType        ContractLineItemType
  quantity        Decimal              @db.Decimal(10, 2)
  unitPriceCents  Int
  totalPriceCents Int
  recurring       Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  // Relationships
  workspace       Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
