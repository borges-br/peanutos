{
  "name": "@peanut/db",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma ORM database definitions, migrations, and seed scripts for Peanut OS",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "generate": "node scripts/with-root-env.js prisma generate",
    "migrate": "node scripts/with-root-env.js prisma migrate dev",
    "migrate:deploy": "node scripts/with-root-env.js prisma migrate deploy",
    "seed": "node scripts/with-root-env.js ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@peanut/utils": "workspace:^",
    "@prisma/client": "^5.14.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "prisma": "^5.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
