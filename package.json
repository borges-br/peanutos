{
  "name": "peanut-os",
  "version": "0.1.0",
  "private": true,
  "description": "Peanut OS - Operational Management Platform for IT Service Providers",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "db:generate": "pnpm --filter @peanut/db generate",
    "db:migrate": "pnpm --filter @peanut/db migrate",
    "db:migrate:deploy": "pnpm --filter @peanut/db migrate:deploy",
    "db:seed": "pnpm --filter @peanut/db seed",
    "test:storage-timezone": "node --test tests/storage-timezone.test.cjs",
    "test:contract-billing": "node --test tests/contract-billing.test.cjs",
    "test:contract-billing:postgres": "node tests/run-contract-postgres.cjs",
    "test:contract-billing:ui": "node tests/contract-billing-ui.cjs",
    "test:contract-billing:pdf": "node tests/render-contract-billing.cjs",
    "test:settings:postgres": "node tests/run-contract-postgres.cjs",
    "test:settings:ui": "node tests/settings-ui.cjs",
    "test:branding": "node --test tests/branding-core.test.cjs tests/branding-http.test.cjs tests/static-svg.test.cjs",
    "test:branding:postgres": "node tests/run-branding-postgres.cjs",
    "test:branding:ui": "node tests/branding-ui.cjs"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "turbo": "^1.13.0",
    "typescript": "^5.4.5"
  },
  "packageManager": "pnpm@9.1.1"
}
