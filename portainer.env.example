# Variaveis para portainer-stack.yml na instalacao EXISTENTE.
# Copie os valores EXATOS da configuracao anterior. Nao gere senhas ou chaves.
# Os campos obrigatorios ficam vazios para impedir o deploy sem preenchimento.
# O .env.example da raiz e de desenvolvimento e nao substitui este arquivo.
# Na VPS inspecionada, a configuracao anterior foi preservada pelo Portainer
# em compose/102/v5/stack.env dentro do volume portainer_data. Nao a publique.

# URL publica real e origem CORS atuais (exemplo de formato: https://app.seudominio).
NEXT_PUBLIC_WEB_URL=
CORS_ORIGIN=

# Mesmos usuario, senha e banco ja existentes em peanutos-infra_postgres_data.
# DATABASE_URL sozinho nao substitui estes tres campos neste Compose.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Valores existentes, sem alteracao.
REDIS_PASSWORD=
JWT_SECRET=
APP_ENCRYPTION_KEY=
WEBHOOK_ENCRYPTION_KEY=

# Preserve tambem este alias se ele existia no ambiente anterior.
APPLICATION_ENCRYPTION_KEY=

# Limites dos processos. Preserve outros valores se voce ja os ajustou.
API_BODY_LIMIT_BYTES=26214400
PDF_MAX_CONCURRENCY=1
WEBHOOK_MAX_CONCURRENCY=5

# SMTP, fuso, sessao e alertas sao configurados pela interface.
# As imagens e STORAGE_PATH ja estao fixados no portainer-stack.yml.
