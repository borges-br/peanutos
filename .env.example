# ==============================================================================
# PEANUT OS - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and adjust the variables for your local development setup.
# DO NOT commit real secrets/production values to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# BRAND & WHITE-LABEL CUSTOMIZATION
# ------------------------------------------------------------------------------
# Customize the brand name of the system (white-label). Default: Peanut OS
NEXT_PUBLIC_BRAND_NAME="Peanut OS"
NEXT_PUBLIC_COMPANY_NAME="Peanut OS Corp"
NEXT_PUBLIC_SUPPORT_EMAIL="support@example.com"
NEXT_PUBLIC_WEB_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"

# ------------------------------------------------------------------------------
# SYSTEM PORT CONFIGURATIONS
# ------------------------------------------------------------------------------
PORT_API=3001
PORT_WEB=3000
PORT_WORKER=3002
API_BODY_LIMIT_BYTES=26214400

# ------------------------------------------------------------------------------
# DATABASE CONNECTION (PostgreSQL + Prisma)
# ------------------------------------------------------------------------------
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=[schema]
DATABASE_URL="postgresql://peanut_user:change-me-in-production@localhost:5432/peanut_db?schema=public"

# ------------------------------------------------------------------------------
# REDIS (Used for BullMQ and general cache)
# ------------------------------------------------------------------------------
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD="change-me-in-production"

# ------------------------------------------------------------------------------
# SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Secret keys for JWT signing (short-lived access tokens) and Session management
JWT_SECRET="change-me-in-production-at-least-32-chars-long"
JWT_EXPIRES_IN="45m"
REFRESH_TOKEN_SECRET="change-me-in-production-at-least-32-chars-long"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Cookie Security (local development = false, production = true)
COOKIE_SECURE=false
COOKIE_DOMAIN="localhost"

# CORS origins accepted by the API. Use comma-separated origins in production.
# Example: CORS_ORIGIN="https://app.example.com,https://admin.example.com"
CORS_ORIGIN="http://localhost:3000"

# Encryption Key for Application-level encryption of sensitive inventory data
# Must be a 32-byte key in hex format (64 characters) or base64 (44 characters)
# Generate locally using: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY="change-me-generate-a-real-32-byte-key"
APPLICATION_ENCRYPTION_KEY="000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"

# ------------------------------------------------------------------------------
# OBJECT STORAGE (MinIO / AWS S3 Compatible)
# ------------------------------------------------------------------------------
# S3_ENDPOINT works as http://localhost:9000 when running on host/WSL.
# If running in a Docker network, use the service name: http://peanut_minio:9000
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minio_admin"
S3_SECRET_KEY="change-me-in-production"
S3_BUCKET="peanut-documents"
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=true

# ------------------------------------------------------------------------------
# WEBHOOK DISPATCH (n8n Integration)
# ------------------------------------------------------------------------------
# Signature key used to sign HTTP payloads with HMAC SHA256
WEBHOOK_SIGNING_SECRET="change-me-in-production-signing-secret"
WEBHOOK_ENCRYPTION_KEY="peanut-os-webhook-key-change-in-production!!"
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_CONCURRENCY=5
WEBHOOK_SCHEDULER_TIMEZONE="America/Sao_Paulo"
WEBHOOK_INVOICE_DUE_SOON_HOURS=72
WEBHOOK_CONTRACT_ENDING_SOON_DAYS=15
WEBHOOK_TICKET_FEEDBACK_HOURS_AFTER_RESOLVED=24

# Billing schedule worker cron expression
BILLING_SCHEDULE_CRON="0 2 * * *"

# ------------------------------------------------------------------------------
# PDF ENGINE (Playwright / Chromium Worker)
# ------------------------------------------------------------------------------
# Maximum concurrent PDF generation jobs on this worker
PDF_MAX_CONCURRENCY=1

# ------------------------------------------------------------------------------
# SMTP / EMAIL DELIVERY (Optional simple SMTP setup)
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="smtp_user"
SMTP_PASS="smtp_pass"
SMTP_FROM_EMAIL="noreply@example.com"

# ------------------------------------------------------------------------------
# LOGGING & AUDIT
# ------------------------------------------------------------------------------
# Log level: fatal, error, warn, info, debug, trace
LOG_LEVEL="info"
